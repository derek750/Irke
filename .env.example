# Google OAuth client for the Drive connection. Copy this file to .env.local and fill it in.
#
# 1. Google Cloud console → APIs & Services → enable the Google Drive API
# 2. Credentials → Create credentials → OAuth client ID → application type: Chrome Extension
# 3. Paste your unpacked extension's ID (chrome://extensions) as the Item ID
# 4. Put the generated client ID below, then `npm run build` and reload the extension
#
# Leave it unset and everything except Google Drive still works.
VITE_GOOGLE_CLIENT_ID=
