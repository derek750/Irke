# Copy this file to .env.local and fill in the values you need, then `npm run build`.
# Leave a value unset and that connection stays unavailable; everything else still works.

# Google OAuth client for Drive (application type: Chrome Extension).
# 1. Enable the Google Drive API in Google Cloud
# 2. Create an OAuth client ID → Chrome Extension → paste your unpacked extension ID
# 3. Put the client ID below
VITE_GOOGLE_CLIENT_ID=

# GitHub OAuth App for the GitHub connection (PKCE — no client secret needed).
# 1. github.com/settings/developers → OAuth Apps → New OAuth App
# 2. Homepage URL: anything (e.g. http://localhost)
# 3. Authorization callback URL: https://<your-extension-id>.chromiumapp.org/
#    (extension ID is on chrome://extensions with Developer mode on)
# 4. Put the client ID below
VITE_GITHUB_CLIENT_ID=
