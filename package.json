{
  "name": "irke",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Drafts open-ended application answers from your own notes, Drive, and GitHub.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run smoke:retrieval && npm run smoke:detect && npm run smoke:prompt && npm run smoke:generate",
    "smoke:retrieval": "esbuild scripts/smoke-retrieval.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/irke-retrieval.mjs --log-level=error && node node_modules/.cache/irke-retrieval.mjs",
    "smoke:detect": "esbuild scripts/smoke-detect.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/irke-detect.mjs --log-level=error && node node_modules/.cache/irke-detect.mjs",
    "smoke:prompt": "esbuild scripts/smoke-prompt.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/irke-prompt.mjs --log-level=error && node node_modules/.cache/irke-prompt.mjs",
    "smoke:generate": "esbuild scripts/smoke-generate.ts --bundle --platform=node --format=esm --alias:@/lib/db=./scripts/stubs/db.ts --alias:@/lib/llm=./scripts/stubs/llm.ts --alias:@/lib/settings=./scripts/stubs/settings.ts --alias:@/lib/answer-bank=./scripts/stubs/answer-bank.ts --alias:@/lib/context/embed=./scripts/stubs/embed.ts --outfile=node_modules/.cache/irke-generate.mjs --log-level=error && node node_modules/.cache/irke-generate.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
