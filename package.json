{
  "name": "irke",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Chrome extension that reads job descriptions and application questions, then drafts grounded answers from your personal brain.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "esbuild scripts/smoke-retrieval.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/irke-smoke.mjs --log-level=error && node node_modules/.cache/irke-smoke.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.2.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
